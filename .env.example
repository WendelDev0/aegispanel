# ==============================================================================
# AegisPanel - variáveis de ambiente
#
# Copie para .env e preencha ANTES do primeiro "docker compose up".
# O backend se recusa a iniciar em produção sem JWT_SECRET e ENCRYPTION_KEY.
# ==============================================================================

# Assina os tokens de sessão. Gere com: openssl rand -hex 32
JWT_SECRET=

# Criptografa senhas de banco e tokens do GitHub em repouso.
# Deve ser DIFERENTE de JWT_SECRET: assim é possível rotacionar as sessões sem
# tornar ilegível tudo que já foi gravado.
# Gere com: openssl rand -hex 32
ENCRYPTION_KEY=

# Fuso horário aplicado a todos os contêineres.
TZ=America/Sao_Paulo

# Interface em que o painel escuta.
# 127.0.0.1  -> apenas local (recomendado; use SSH tunnel ou Caddy/HTTPS)
# 0.0.0.0    -> acesso HTTP público, não recomendado
PANEL_BIND=127.0.0.1

# Origens de navegador permitidas, separadas por vírgula.
# Vazio = apenas mesma origem, que é o correto quando o acesso passa pelo
# nginx/Caddy do próprio painel. Se vazio e settings.panelDomain estiver
# definido, o backend também aceita https://<panelDomain>.
# CORS_ORIGINS=https://painel.seudominio.com

# Administradores precisam de 2FA (TOTP) para abrir o terminal do host.
# Default: true em produção. false desliga a exigência.
# AEGIS_REQUIRE_2FA_ADMIN=true

# URL pública canônica usada em webhooks e workflows gerados pelo painel.
# Em produção, use HTTPS e o domínio controlado por esta instalação.
# AEGIS_PUBLIC_BASE_URL=https://painel.seudominio.com

# Diretório do clone que contém docker-compose.yml. Obrigatório para o
# self-update quando o processo não está com cwd nesse diretório (o backend
# no container usa /app). O install.sh grava o caminho automaticamente
# (padrão: /opt/aegispanel). O volume no compose monta este path em si mesmo
# para o daemon resolver bind mounts e build contexts.
# AEGIS_COMPOSE_DIR=/opt/aegispanel

# Branch ou tag que esta máquina acompanha. O self-update faz fetch/checkout
# desta ref antes de reconstruir — sem isso ele recompila o que já está em
# disco e "atualiza" para a mesma versão. Nunca vem do corpo da requisição:
# uma sessão admin puxando uma ref escolhida por terceiros reconstruiria o
# painel, como root, a partir do código dessa pessoa.
# AEGIS_UPDATE_REF=main

# Host público do Supabase self-hosted, sem protocolo.
# Sem esta variável o painel não exibe links nem credenciais do Supabase.
# AEGIS_SUPABASE_PUBLIC_HOST=studio-supabase.seudominio.com

# Faixas CIDR de um CDN/proxy na frente do Caddy (ex: Cloudflare), separadas
# por vírgula. Quando definidas, o Caddy passa a ler o IP real do visitante do
# cabeçalho X-Forwarded-For — sem isso, o analytics registra o IP do CDN e
# atribui todas as visitas a alguns datacenters.
#
# Deixe VAZIO se não houver proxy na frente: confiar nesse cabeçalho sem um
# proxy real permite que qualquer visitante forje o próprio endereço.
#
# Lista atual do Cloudflare (ela muda; confira antes de colar):
#   curl -s https://www.cloudflare.com/ips-v4 | paste -sd,
#   curl -s https://www.cloudflare.com/ips-v6 | paste -sd,
# AEGIS_TRUSTED_PROXIES=

# Analytics: resolve o IP do visitante para país/cidade via ip-api.com.
# O IP sai da VPS para esse serviço; só o resultado agregado é armazenado.
# Defina como false para desligar a geolocalização (visitas continuam sendo
# contadas, mas o globo fica vazio).
GEOIP_ENABLED=false

# Escape hatch: em NODE_ENV !== production o painel bloqueia upload offsite
# (uma cópia local de panel_db.json não deve empurrar dumps para o bucket real).
# AEGIS_ALLOW_OFFSITE_BACKUP=true

# Disaster recovery (install.sh --restore-from s3://bucket/prefix).
# ENCRYPTION_KEY deve ser a da instalação antiga. Estas variáveis também
# alimentam o script backend/src/scripts/dr-restore.ts.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=auto
# AWS_ENDPOINT_URL=
