# ==============================================================================
# AegisPanel - variáveis de ambiente
#
# Copie para .env e preencha ANTES do primeiro "docker compose up".
# O backend se recusa a iniciar em produção sem JWT_SECRET e ENCRYPTION_KEY.
# ==============================================================================

# Assina os tokens de sessão. Gere com: openssl rand -hex 32
JWT_SECRET=

# Criptografa senhas de banco e tokens do GitHub em repouso.
# Deve ser DIFERENTE de JWT_SECRET: assim é possível rotacionar as sessões sem
# tornar ilegível tudo que já foi gravado.
# Gere com: openssl rand -hex 32
ENCRYPTION_KEY=

# Fuso horário aplicado a todos os contêineres.
TZ=America/Sao_Paulo

# Interface em que o painel escuta.
# 0.0.0.0    -> acessível em http://SEU_IP:3000 (padrão, útil na instalação)
# 127.0.0.1  -> apenas local; use depois de publicar o painel via Caddy/HTTPS
PANEL_BIND=0.0.0.0

# Origens de navegador permitidas, separadas por vírgula.
# Vazio = apenas mesma origem, que é o correto quando o acesso passa pelo
# nginx/Caddy do próprio painel.
# CORS_ORIGINS=https://painel.seudominio.com

# Analytics: resolve o IP do visitante para país/cidade via ip-api.com.
# O IP sai da VPS para esse serviço; só o resultado agregado é armazenado.
# Defina como false para desligar a geolocalização (visitas continuam sendo
# contadas, mas o globo fica vazio).
GEOIP_ENABLED=true
